diff --git a/kernel/susfs/susfs_glue.c b/kernel/susfs/susfs_glue.c
new file mode 100644
--- /dev/null
+++ b/kernel/susfs/susfs_glue.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KernelSU-Next <-> SUSFS v2.4.0 glue.
+ *
+ * SUSFS is compiled into vmlinux (fs/susfs.o) because on a non-GKI 4.14 kernel
+ * its hooks live in core kernel files (fs/namei.c, fs/exec.c, fs/proc/...).
+ * The code here is the KernelSU side that SUSFS needs:
+ *
+ *   - ksu_susfs_init(), the single initialisation entry point (susfs_init()),
+ *   - ksu_susfs_handle_ioctl(), the privileged command endpoint through which
+ *     the ksu_susfs userspace tool talks to the kernel,
+ *   - the delayed-work plumbing that KernelSU triggers once an app was
+ *     umounted, and the /sdcard decryption monitor start,
+ *   - the SELinux type bookkeeping used by selinux_hide / avc log spoofing.
+ *
+ * Everything is behind CONFIG_KSU_SUSFS so the tree still builds without it.
+ */
+#include <linux/cred.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+#include <linux/version.h>
+#include <linux/workqueue.h>
+
+#include <linux/susfs_def.h>
+
+#include "klog.h" // IWYU pragma: keep
+#include "ksu.h"
+#include "policy/allowlist.h"
+#include "selinux/selinux.h"
+#include "compat/kernel_compat.h"
+#include "uapi/supercall.h"
+#include "susfs/susfs_glue.h"
+
+#ifdef CONFIG_KSU_SUSFS
+
+/*
+ * SUSFS entry points. <linux/susfs.h> is part of the kernel tree, but pulling it
+ * in here would drag the whole SUSFS internal state into the KernelSU build and
+ * break the LKM variant, where CONFIG_KSU_SUSFS is never set. Only the handful
+ * of prototypes KernelSU actually calls is declared.
+ */
+extern void susfs_init(void);
+extern void susfs_start_sdcard_monitor_fn(void);
+extern void susfs_parse_priority_app_strings(void);
+extern struct work_struct susfs_extra_works;
+
+extern int susfs_add_sus_type(const char *secctx, u32 type_value);
+extern int susfs_add_sus_avd_allowed_by_type(u32 s_type, u32 t_type, u32 c_type,
+					     u32 orig_avd_allowed);
+extern bool susfs_is_sus_type_rcu(u32 type_value);
+
+extern void susfs_show_version(void __user **user_info);
+extern void susfs_show_variant(void __user **user_info);
+extern void susfs_get_enabled_features(void __user **user_info);
+extern void susfs_set_uname(void __user **user_info);
+extern void susfs_set_cmdline_or_bootconfig(void __user **user_info);
+extern void susfs_enable_log(void __user **user_info);
+extern void susfs_set_avc_log_spoofing(void __user **user_info);
+extern void susfs_add_sus_path(void __user **user_info);
+extern void susfs_add_sus_path_loop(void __user **user_info);
+extern void susfs_add_sus_kstat(void __user **user_info);
+extern void susfs_update_sus_kstat(void __user **user_info);
+extern void susfs_set_hide_sus_mnts_for_non_su_procs(void __user **user_info);
+extern void susfs_add_open_redirect(void __user **user_info);
+extern void susfs_add_sus_map(void __user **user_info);
+extern void susfs_set_priority_uid_filter(void __user **user_info);
+
+void ksu_susfs_init(void)
+{
+	pr_info("susfs: initialising\n");
+	susfs_init();
+}
+
+void ksu_susfs_boot_completed(void)
+{
+	/*
+	 * Started from the boot_completed report, i.e. once the userspace has
+	 * finished bringing the storage up. From that point on /sdcard is
+	 * decrypted and the sus mounts must not be hidden any more.
+	 */
+	susfs_start_sdcard_monitor_fn();
+}
+
+void ksu_susfs_handle_setresuid(void)
+{
+	/*
+	 * Called right after KernelSU umounted an app process. The work is
+	 * deferred so the syscall path is not blocked and the time side channel
+	 * stays as small as possible.
+	 */
+	if (work_pending(&susfs_extra_works))
+		return;
+	schedule_work(&susfs_extra_works);
+}
+
+void ksu_susfs_handle_post_fs_data(void)
+{
+	susfs_parse_priority_app_strings();
+}
+
+/*
+ * SELinux type bookkeeping. Called from the policy handling so SUSFS can
+ * recognise the types and rules it has to answer for.
+ */
+int ksu_susfs_add_sus_type(const char *secctx, u32 type_value)
+{
+	return susfs_add_sus_type(secctx, type_value);
+}
+
+int ksu_susfs_add_sus_av_rule(u32 s_type, u32 t_type, u32 c_type,
+			      u32 orig_avd_allowed)
+{
+	return susfs_add_sus_avd_allowed_by_type(s_type, t_type, c_type,
+						 orig_avd_allowed);
+}
+
+bool ksu_susfs_is_sus_type(u32 type_value)
+{
+	return susfs_is_sus_type_rcu(type_value);
+}
+
+/*
+ * Privileged command endpoint.
+ *
+ * The ksu_susfs userspace tool opens the ksu driver fd and issues
+ * KSU_IOCTL_SUSFS_CMD with { subcmd = CMD_SUSFS_*, arg = &its_struct }.
+ * The permission check is the same as for the other sensitive KernelSU
+ * commands: only the manager, root and the apps allowed for su may talk to it.
+ */
+long ksu_susfs_handle_ioctl(void __user *argp)
+{
+	struct ksu_susfs_cmd cmd;
+	void __user *user_info;
+
+	if (copy_from_user(&cmd, argp, sizeof(cmd)))
+		return -EFAULT;
+
+	if (!cmd.arg)
+		return -EINVAL;
+
+	user_info = (void __user *)(uintptr_t)cmd.arg;
+
+	switch (cmd.subcmd) {
+	case CMD_SUSFS_SHOW_VERSION:
+		susfs_show_version(&user_info);
+		break;
+	case CMD_SUSFS_SHOW_VARIANT:
+		susfs_show_variant(&user_info);
+		break;
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		susfs_get_enabled_features(&user_info);
+		break;
+	case CMD_SUSFS_SET_UNAME:
+		susfs_set_uname(&user_info);
+		break;
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		susfs_set_cmdline_or_bootconfig(&user_info);
+		break;
+	case CMD_SUSFS_ENABLE_LOG:
+		susfs_enable_log(&user_info);
+		break;
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		susfs_set_avc_log_spoofing(&user_info);
+		break;
+	case CMD_SUSFS_ADD_SUS_PATH:
+		susfs_add_sus_path(&user_info);
+		break;
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		susfs_add_sus_path_loop(&user_info);
+		break;
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		susfs_add_sus_kstat(&user_info);
+		break;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		susfs_update_sus_kstat(&user_info);
+		break;
+	case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+		susfs_set_hide_sus_mnts_for_non_su_procs(&user_info);
+		break;
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		susfs_add_open_redirect(&user_info);
+		break;
+	case CMD_SUSFS_ADD_SUS_MAP:
+		susfs_add_sus_map(&user_info);
+		break;
+	case CMD_SUSFS_SET_PRIORITY_UID_FILTER:
+		susfs_set_priority_uid_filter(&user_info);
+		break;
+	default:
+		pr_warn("susfs: unsupported command 0x%llu\n",
+			(unsigned long long)cmd.subcmd);
+		return -ENOTTY;
+	}
+
+	return 0;
+}
+
+#endif /* CONFIG_KSU_SUSFS */
diff --git a/kernel/susfs/susfs_glue.h b/kernel/susfs/susfs_glue.h
new file mode 100644
--- /dev/null
+++ b/kernel/susfs/susfs_glue.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __KSU_H_SUSFS_GLUE
+#define __KSU_H_SUSFS_GLUE
+
+#include <linux/types.h>
+
+#ifdef CONFIG_KSU_SUSFS
+
+void ksu_susfs_init(void);
+void ksu_susfs_boot_completed(void);
+void ksu_susfs_handle_setresuid(void);
+void ksu_susfs_handle_post_fs_data(void);
+
+int ksu_susfs_add_sus_type(const char *secctx, u32 type_value);
+int ksu_susfs_add_sus_av_rule(u32 s_type, u32 t_type, u32 c_type,
+			      u32 orig_avd_allowed);
+bool ksu_susfs_is_sus_type(u32 type_value);
+
+long ksu_susfs_handle_ioctl(void __user *argp);
+
+#else /* CONFIG_KSU_SUSFS */
+
+static inline void ksu_susfs_init(void) { }
+static inline void ksu_susfs_boot_completed(void) { }
+static inline void ksu_susfs_handle_setresuid(void) { }
+static inline void ksu_susfs_handle_post_fs_data(void) { }
+
+static inline int ksu_susfs_add_sus_type(const char *secctx, u32 type_value)
+{
+	return 0;
+}
+
+static inline int ksu_susfs_add_sus_av_rule(u32 s_type, u32 t_type, u32 c_type,
+					    u32 orig_avd_allowed)
+{
+	return 0;
+}
+
+static inline bool ksu_susfs_is_sus_type(u32 type_value)
+{
+	return false;
+}
+
+static inline long ksu_susfs_handle_ioctl(void __user *argp)
+{
+	return -ENOTTY;
+}
+
+#endif /* CONFIG_KSU_SUSFS */
+
+#endif /* __KSU_H_SUSFS_GLUE */
diff --git a/uapi/supercall.h b/uapi/supercall.h
--- a/uapi/supercall.h
+++ b/uapi/supercall.h
@@ -223,5 +223,20 @@
 #define KSU_IOCTL_LOOKUP_SYMBOLS _IOW('K', 22, struct ksu_lookup_symbols_cmd)
 #define KSU_IOCTL_GET_HOOK_MODE _IOC(_IOC_READ, 'K', 98, 0)
 #define KSU_IOCTL_GET_VERSION_TAG _IOC(_IOC_READ, 'K', 99, 0)
+/*
+ * SUSFS v2.4.0.
+ *
+ * One ioctl carries every SUSFS command: 'subcmd' is one of the
+ * CMD_SUSFS_* values from <linux/susfs_def.h> and 'arg' is the address of
+ * the per-command struct that the ksu_susfs userspace tool allocated.
+ * Keeping a single ioctl means the wire format of the SUSFS userspace tool is
+ * unchanged and the kernel side stays a thin dispatcher.
+ */
+struct ksu_susfs_cmd {
+	__u64 subcmd;
+	__u64 arg;
+};
+
+#define KSU_IOCTL_SUSFS_CMD _IOWR('K', 100, struct ksu_susfs_cmd)
 
 #endif
